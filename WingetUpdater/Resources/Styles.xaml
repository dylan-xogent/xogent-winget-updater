<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Modern Color Scheme -->
    <SolidColorBrush x:Key="PrimaryGradientStart" Color="#667eea"/>
    <SolidColorBrush x:Key="PrimaryGradientEnd" Color="#764ba2"/>
    <SolidColorBrush x:Key="BackgroundColor" Color="#1a1a2e"/>
    <SolidColorBrush x:Key="TextColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextColor" Color="#B0B0B0"/>
    
</ResourceDictionary>

